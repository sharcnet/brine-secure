#!/usr/bin/env bash
# Admin CLI for the grant-review VM. Runs on an admin's laptop (macOS bash 3.2 is fine).
# Reads ./review.env (copy review.env.example), or the file named by $REVIEW_ENV (the local
# test VM uses local/review.env). Run `review help` for the commands.
#
# Secrets never go into command arguments: the LiteLLM admin credential is a header file,
# and each new reviewer key is held in a shell variable and piped to the VM over SSH.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)
repo=$(cd "$here/.." && pwd -P)
die() { echo "error: $*" >&2; exit 1; }
confirm() { local a; read -r -p "$1 Type '$2' to continue: " a; [[ $a == "$2" ]] || die "cancelled"; }
valid_user() { [[ ${1:-} =~ ^[a-z][a-z0-9_-]{0,30}$ ]]; }
valid_file() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$ ]]; }

envf=${REVIEW_ENV:-$here/review.env}
[[ -r $envf ]] || die "copy review.env.example to review.env and fill it in"
# shellcheck source=/dev/null
source "$envf"
sshdir=${REVIEW_SSH_DIR:-$here/.ssh}
local_test=${LOCAL_TEST:-0}   # 1 = the local Lima test VM: no OpenStack, never touch brine keys
shared_key=${SHARED_TEST_KEY:-0}  # 1 = every reviewer uses one admin's own brine key (a pilot): never revoke it
: "${VM_ADMIN:=ubuntu}" "${BRINE_URL:=https://brine.sharcnet.ca}"
: "${WEB_AUTH:=basic}" "${SSO_ISSUER:=https://cilogon.org}" "${SSO_DOMAIN:=alliancecan.ca}"
: "${SSO_IDP:=https://idp.alliancecan.ca/idp/shibboleth}" "${SSO_MFA:=https://refeds.org/profile/mfa}"
: "${SSO_CIDRS:=75.2.49.220/32 99.83.186.75/32}"   # cilogon.org (AWS Global Accelerator)
brine_host=${BRINE_URL#https://}; brine_host=${brine_host%%/*}

# ---------- helpers ----------

os() {
  if command -v openstack >/dev/null; then openstack "$@"
  else command -v uv >/dev/null || die "need the openstack CLI (or uv; see the top-level README)"
       uv run --project "$repo" openstack "$@"; fi
}

brine_ips_json() {
  local ips=${BRINE_IPS:-}
  [[ -n $ips ]] || ips=$(dig +short A "$brine_host" | grep -E '^[0-9.]+$' | sort -u | tr '\n' ' ')
  [[ -n ${ips// /} ]] || die "cannot resolve $brine_host (set BRINE_IPS in review.env)"
  printf '%s\n' $ips | jq -R . | jq -cs .
}

tf() {
  command -v terraform >/dev/null || die "terraform not installed"
  local sub=$1; shift
  terraform -chdir="$here/terraform" "$sub" -var "brine_ips=$(brine_ips_json)" "$@"
}

vm_ip() {
  local out=ip
  [[ ${VM_ADDRESS:-floating} == fixed ]] && out=fixed_ip   # from the admin VM, on the project network
  if [[ -n ${VM_HOST:-} ]]; then echo "$VM_HOST"
  else terraform -chdir="$here/terraform" output -raw "$out" 2>/dev/null || die "no VM yet (review apply)"; fi
}

vm_ssh() {
  local tty=""
  [[ ${1:-} == -t ]] && { tty=-t; shift; }
  [[ -s $sshdir/known_hosts ]] || die "host key not pinned yet: review pin-hostkey"
  ssh $tty -o HostKeyAlias=review-vm -o UserKnownHostsFile="$sshdir/known_hosts" \
      -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 \
      ${ADMIN_SSH_KEY:+-i "$ADMIN_SSH_KEY"} "$VM_ADMIN@$(vm_ip)" "$@"
}

# macOS tar would otherwise pack Apple metadata that GNU tar on the VM warns about.
mac_tar=""; [[ $(uname) == Darwin ]] && mac_tar="--no-xattrs --no-mac-metadata"

# Fetch the oauth2-proxy release for the VM's architecture into $here/.cache (once), check it
# against the pins in vm/files/oauth2-proxy.sha256, and copy it into the source dir $1.
fetch_oauth2_proxy() {
  local dir=$1 arch pins=$here/vm/files/oauth2-proxy.sha256 f want ver got
  arch=$(vm_ssh 'dpkg --print-architecture') || return 1
  f=$(awk -v a="linux-$arch.tar.gz" '$2 ~ a"$" {print $2}' "$pins"); want=$(awk -v f="$f" '$2 == f {print $1}' "$pins")
  ver=$(awk '/^# version [0-9]/ {print $3}' "$pins")
  [[ -n $f && -n $want && -n $ver ]] || { echo "no pinned oauth2-proxy for $arch" >&2; return 1; }
  mkdir -p "$here/.cache"
  if [[ ! -f $here/.cache/$f ]]; then
    curl -fsSL -o "$here/.cache/$f.part" "https://github.com/oauth2-proxy/oauth2-proxy/releases/download/v$ver/$f" || return 1
    mv "$here/.cache/$f.part" "$here/.cache/$f"
  fi
  got=$( (sha256sum "$here/.cache/$f" 2>/dev/null || shasum -a 256 "$here/.cache/$f") | cut -d' ' -f1)
  [[ $got == "$want" ]] || { rm -f "$here/.cache/$f"; echo "$f does not match its pinned SHA-256" >&2; return 1; }
  cp "$here/.cache/$f" "$dir/$f"
}

# Copy vm/ plus a generated review.conf to /root/brine-review-src on the VM.
push_src() {
  local t rc=0; t=$(mktemp -d)
  cp -R "$here/vm/." "$t/"
  {
    printf 'BRINE_HOST=%q\n' "$brine_host"
    printf 'ADMIN_CIDRS=%q\n' "$ADMIN_CIDRS"
    printf 'QUOTA_GB=%q\n' "${QUOTA_GB:-2}"
    printf 'CTR_MEMORY=%q\nCTR_CPUS=%q\nCTR_PIDS=%q\n' "${CTR_MEMORY:-2g}" "${CTR_CPUS:-2}" "${CTR_PIDS:-256}"
    printf 'WEB_AUTH=%q\nLOCAL_TEST=%q\n' "$WEB_AUTH" "$local_test"
    printf 'SSO_HOST=%q\nSSO_CLIENT_ID=%q\nSSO_ISSUER=%q\n' "${SSO_HOST:-}" "${SSO_CLIENT_ID:-}" "$SSO_ISSUER"
    printf 'SSO_IDP=%q\nSSO_MFA=%q\nSSO_DOMAIN=%q\nSSO_CIDRS=%q\n' "$SSO_IDP" "$SSO_MFA" "$SSO_DOMAIN" "$SSO_CIDRS"
    printf 'CERT_PUSH_KEY=%q\nCERT_PUSH_CIDRS=%q\n' "${CERT_PUSH_KEY:-}" "${CERT_PUSH_CIDRS:-}"
    printf 'ROOT_SSH_KEYS=%q\nROOT_SSH_CIDRS=%q\n' "${ROOT_SSH_KEYS:-}" "${ROOT_SSH_CIDRS:-}"
  } > "$t/review.conf"
  if [[ $WEB_AUTH == sso ]]; then
    [[ -n ${SSO_HOST:-} && -n ${SSO_CLIENT_ID:-} ]] || { rm -rf "$t"; die "WEB_AUTH=sso needs SSO_HOST and SSO_CLIENT_ID in review.env"; }
    fetch_oauth2_proxy "$t" || { rm -rf "$t"; die "could not fetch a verified oauth2-proxy"; }
  fi
  COPYFILE_DISABLE=1 tar $mac_tar -C "$t" -cf - . | vm_ssh 'sudo -n rm -rf /root/brine-review-src &&
    sudo -n install -d -m 0700 /root/brine-review-src &&
    sudo -n tar --no-same-owner -C /root/brine-review-src -xf -' || rc=$?
  rm -rf "$t"
  return $rc
}

# LiteLLM admin call. Body on stdin; credential from the header file; key stays in memory.
litellm() {
  [[ -r ${LITELLM_ADMIN_HEADER:-} ]] || die "LITELLM_ADMIN_HEADER must name a 0600 file holding 'Authorization: Bearer ...'"
  curl -fsS -X POST "$BRINE_URL/$1" -H @"$LITELLM_ADMIN_HEADER" \
       -H 'Content-Type: application/json' --data-binary @-
}

key_alias_of() {
  vm_ssh "sudo -n awk '\$2 == \"$1\" { print \$1 }' /etc/brine-review/keys/aliases" | tail -1
}

revoke_alias() {
  if [[ $local_test == 1 || $shared_key == 1 ]]; then
    echo "not revoking $1: test reviewers share one admin's brine key (LOCAL_TEST/SHARED_TEST_KEY)"; return 0
  fi
  if [[ -z ${LITELLM_ADMIN_HEADER:-} ]]; then
    echo "ASK A BRINE ADMIN to revoke the key with alias $1 now (no minting credential here)" >&2; return 1
  fi
  # [VERIFY] /key/delete accepts key_aliases on brine's LiteLLM version.
  jq -n --arg a "$1" '{key_aliases: [$a]}' | litellm key/delete >/dev/null \
    && echo "revoked LiteLLM key $1" \
    || { echo "REVOKE FAILED for $1: revoke it on brine by hand" >&2; return 1; }
}

check_lock() {
  local port group sgs
  if [[ $local_test == 1 ]]; then
    echo "LOCAL_TEST: no OpenStack security groups to check"
  else
  port=$(terraform -chdir="$here/terraform" output -raw port_id)
  group=$(terraform -chdir="$here/terraform" output -raw review_group_id)
  sgs=$(os port show "$port" -f json -c security_group_ids | jq -c '.security_group_ids')
  [[ $sgs == "[\"$group\"]" ]] || die "VM port has extra security groups: $sgs"
  echo "port: only $group attached. Its egress rules:"
  os security group rule list "$group" --egress -f value -c "IP Protocol" -c "IP Range" -c "Port Range" | sed 's/^/  /'
  fi
  if [[ -s $sshdir/known_hosts ]]; then
    echo "open connections on the VM (expect only SSH and brine :443):"
    vm_ssh 'ss -tnH state established' | awk '{print "  " $3 " -> " $4}'
  else
    echo "host key not pinned yet: run review pin-hostkey, then review check"
  fi
}

usage() {
  cat <<'EOF'
review plan | apply                 Terraform plan / apply (egress locked)
review pin-hostkey                  Pin the VM's SSH host key from its console log
review setup-egress on|off          Open egress for first setup only (refused once data exists)
review data-volume <device>         Format and mount the data volume (once)
review deploy [--admin-access]      Copy vm/ to the VM and run configure
review image <tar>                  Install an image made by image/build
review add <user> [<keyfile> <gr-alias>]
                                    Create the reviewer (web sign-in off until activate;
                                    reviewers have no SSH). Mints the key itself if
                                    LITELLM_ADMIN_HEADER is set; otherwise takes a key a brine
                                    admin minted (keyfile 0600, plus the alias they gave it)
review stage <file>...              Copy applications into staging on the data volume
review load <assignment.csv>        Load staged applications (username,filename lines)
review manifest <user>              Show a reviewer's manifest for the second-person check
review list [applications|reviewers|csv]
                                    Who has which application: per application (default),
                                    per reviewer (status, web, container, manifest), or CSV
                                    (username,filename,status) to compare with the assignment list
review activate <user> <checked-by> Switch the reviewer's web sign-in on
review unload <user> <file>         Remove one application (conflict of interest)
review remove <user>                Remove a reviewer, purge their data, revoke their key
review revoke <user>                Revoke a reviewer's LiteLLM key only
review web-password <user>          Set a new random web sign-in password and print it once (WEB_AUTH=basic)
review sso-secret [<file>]          Install the CILogon client secret (from a 0600 file, or typed)
review web-cert <cert.pem> <key.pem>
                                    Install a trusted certificate for SSO_HOST (cert.pem = full chain)
review admin-keys <file>            Replace the VM admin account's authorized_keys (add/drop admins)
review check                        Control-plane lock check and open connections
review ssh                          Admin shell on the VM
EOF
}

# ---------- commands ----------

cmd=${1:-help}; shift || true
case $cmd in
  plan)  tf plan "$@" ;;
  apply) tf apply -var setup_egress=false "$@"; check_lock ;;

  pin-hostkey)
    sid=$(terraform -chdir="$here/terraform" output -raw server_id)
    key=$(os console log show "$sid" | tr -d '\r' \
          | sed -n '/BEGIN SSH HOST KEY KEYS/,/END SSH HOST KEY KEYS/p' | grep '^ssh-ed25519 ' | head -1)
    [[ -n $key ]] || die "no ed25519 host key in the console log yet; wait for cloud-init and retry"
    mkdir -p "$sshdir" && chmod 700 "$sshdir"
    printf 'review-vm %s\n' "$(cut -d' ' -f1-2 <<<"$key")" > "$sshdir/known_hosts"
    echo "pinned: $(ssh-keygen -lf "$sshdir/known_hosts" | cut -d' ' -f2)"
    echo "Send this fingerprint to reviewers through a separate channel."
    ;;

  setup-egress)
    case ${1:-} in
      on)
        if [[ -s $sshdir/known_hosts ]]; then
          n=$(vm_ssh 'sudo -n find /srv/review/originals /srv/review/staging -type f 2>/dev/null | wc -l') \
            || die "can't check the VM for applications; refusing"
          [[ ${n// /} -eq 0 ]] || die "applications are on the VM; open egress is never allowed again"
        fi
        confirm "This opens all egress from the VM." open
        tf apply -var setup_egress=true ;;
      off) tf apply -var setup_egress=false; check_lock ;;
      *) die "usage: review setup-egress on|off" ;;
    esac ;;

  data-volume)
    [[ ${1:-} =~ ^/dev/[a-z0-9]+$ ]] || die "usage: review data-volume /dev/vdX (see: terraform output volume_device)"
    confirm "Format $1 on the VM? It refuses if $1 already holds anything." format
    push_src
    vm_ssh -t "sudo -n /root/brine-review-src/sbin/setup-data-volume $1" ;;

  deploy)
    [[ -z ${1:-} || $1 == --admin-access ]] || die "usage: review deploy [--admin-access]"
    push_src
    vm_ssh -t "sudo -n bash /root/brine-review-src/configure ${1:-}" ;;

  image)
    tar=${1:-}; [[ -f $tar && -f $tar.sha256 ]] || die "usage: review image <brine-review-*.tar> (with .sha256 beside it)"
    sum=$(< "$tar.sha256"); [[ $sum =~ ^[0-9a-f]{64}$ ]] || die "bad checksum file"
    vm_ssh "sudo -n sh -c 'umask 077; cat > /root/brine-review-image.tar'" < "$tar"
    vm_ssh "sudo -n /usr/local/sbin/install-image /root/brine-review-image.tar $sum; sudo -n rm -f /root/brine-review-image.tar" ;;

  add)
    u=${1:-} keyfile=${2:-} alias_id=${3:-}
    valid_user "$u" || die "usage: review add <user> [<keyfile> <gr-alias>]"
    if [[ -n $keyfile ]]; then
      # Key minted by a brine admin (LiteLLM's team-admin role is an Enterprise feature), or
      # one admin's own key shared by every test reviewer (SHARED_TEST_KEY=1).
      [[ -f $keyfile && $alias_id =~ ^gr-[0-9a-f]{8}$ ]] || die "usage: review add <user> <keyfile> <gr-xxxxxxxx>"
      [[ $(stat -c %a "$keyfile" 2>/dev/null || stat -f %Lp "$keyfile") == 600 ]] || die "$keyfile must be mode 0600"
      vm_ssh "sudo -n /usr/local/sbin/add-reviewer $u $alias_id" < "$keyfile" \
        || die "add-reviewer failed. Clean up with: review remove $u"
      [[ $shared_key == 1 ]] || echo "Now delete $keyfile (rm -P on macOS, shred -u on Linux)."
      exit 0
    fi
    for v in LITELLM_TEAM_ID MODELS KEY_DURATION KEY_BUDGET KEY_RPM KEY_TPM; do
      [[ -n ${!v:-} ]] || die "review.env: $v is not set"
    done
    alias_id="gr-$(openssl rand -hex 4)"
    resp=$(jq -n --arg team "$LITELLM_TEAM_ID" --arg alias "$alias_id" --arg dur "$KEY_DURATION" \
             --argjson models "$(printf '%s\n' $MODELS | jq -R . | jq -cs .)" \
             --argjson budget "$KEY_BUDGET" --argjson rpm "$KEY_RPM" --argjson tpm "$KEY_TPM" \
             '{team_id: $team, key_alias: $alias, models: $models, duration: $dur,
               max_budget: $budget, rpm_limit: $rpm, tpm_limit: $tpm}' \
           | litellm key/generate)                       # [VERIFY] field names on brine's version
    key=$(printf '%s' "$resp" | jq -r '.key // empty'); unset resp
    [[ -n $key ]] || die "brine returned no key"
    if ! printf '%s\n' "$key" | vm_ssh "sudo -n /usr/local/sbin/add-reviewer $u $alias_id"; then
      unset key
      revoke_alias "$alias_id" || true
      die "add-reviewer failed; key $alias_id revoked. Clean up with: review remove $u"
    fi
    unset key ;;

  stage)
    (( $# )) || die "usage: review stage <file>..."
    for f in "$@"; do
      n=$(basename "$f")
      [[ -f $f ]] && valid_file "$n" || die "not a plain file with a plain name: $f"
    done
    for f in "$@"; do
      n=$(basename "$f")
      # Streamed straight onto the data volume: no copy lands on the VM's root disk.
      vm_ssh "sudo -n sh -c 'umask 077; set -C; cat > /srv/review/staging/$n'" < "$f" \
        || die "could not stage $n (already staged?)"
      echo "staged $n"
    done ;;

  load)
    [[ -f ${1:-} ]] || die "usage: review load <assignment.csv>"
    csv=/srv/review/staging/.assignment-$(date +%Y%m%d%H%M%S).csv
    vm_ssh "sudo -n sh -c 'umask 077; cat > $csv'" < "$1"
    vm_ssh "sudo -n /usr/local/sbin/load-applications $csv" ;;

  manifest)
    valid_user "${1:-}" || die "usage: review manifest <user>"
    vm_ssh "sudo -n cat /srv/review/manifests/$1.sha256" | awk '{print $2}' ;;

  list)
    [[ ${1:-applications} =~ ^(applications|reviewers|csv)$ ]] || die "usage: review list [applications|reviewers|csv]"
    vm_ssh "sudo -n /usr/local/sbin/list-assignments ${1:-applications}" ;;

  activate)
    valid_user "${1:-}" && [[ -n ${2:-} ]] || die "usage: review activate <user> <checked-by>"
    [[ $2 =~ ^[A-Za-z][A-Za-z0-9._\ -]{1,60}$ ]] || die "bad checked-by name"
    vm_ssh "sudo -n /usr/local/sbin/activate-reviewer $1 $(printf '%q' "$2")" ;;

  unload)
    valid_user "${1:-}" && valid_file "${2:-}" || die "usage: review unload <user> <file>"
    vm_ssh "sudo -n /usr/local/sbin/unload-application $1 $2" ;;

  remove)
    u=${1:-}; valid_user "$u" || die "usage: review remove <user>"
    confirm "This deletes $u's account, workspace and applications on the VM, and revokes their key. It can't be undone." "$u"
    alias_id=$(key_alias_of "$u")
    vm_ssh "sudo -n /usr/local/sbin/remove-reviewer $u --purge-data"
    if [[ -n $alias_id ]]; then revoke_alias "$alias_id"; else echo "no key alias recorded for $u: check brine"; fi ;;

  revoke)
    u=${1:-}; valid_user "$u" || die "usage: review revoke <user>"
    alias_id=$(key_alias_of "$u"); [[ -n $alias_id ]] || die "no key alias recorded for $u"
    revoke_alias "$alias_id" ;;

  web-password)
    valid_user "${1:-}" || die "usage: review web-password <user>"
    pw=$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-20)
    printf '%s\n' "$pw" | vm_ssh "sudo -n /usr/local/sbin/web-password $1" >/dev/null
    echo "Web password for $1 (shown once; send it through a separate channel): $pw"
    unset pw ;;

  sso-secret)
    [[ $WEB_AUTH == sso ]] || echo "note: WEB_AUTH=$WEB_AUTH in review.env; the secret is used once it is sso" >&2
    if [[ -n ${1:-} ]]; then
      [[ -f $1 ]] || die "usage: review sso-secret [<file>]"
      [[ $(stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1") == 600 ]] || die "$1 must be mode 0600"
      vm_ssh 'sudo -n /usr/local/sbin/install-sso-secret' < "$1"
    else
      read -r -s -p "CILogon client secret: " sec; echo
      printf '%s\n' "$sec" | vm_ssh 'sudo -n /usr/local/sbin/install-sso-secret'
      unset sec
    fi ;;

  web-cert)
    crt=${1:-} key=${2:-}; [[ -f $crt && -f $key ]] || die "usage: review web-cert <cert.pem> <key.pem>"
    t=$(mktemp -d); cp "$crt" "$t/tls.crt"; ( umask 077; cp "$key" "$t/tls.key" )
    COPYFILE_DISABLE=1 tar $mac_tar -C "$t" -cf - tls.crt tls.key | vm_ssh 'sudo -n /usr/local/sbin/install-web-cert'; rc=$?
    rm -rf "$t"; exit $rc ;;

  admin-keys)
    # Replace the VM admin account's authorized_keys, e.g. to add or drop an admin. The file
    # must hold plain public keys only, and must include the key this command connects with.
    f=${1:-}; [[ -f $f ]] || die "usage: review admin-keys <authorized_keys-file>"
    me="${ADMIN_SSH_KEY:-$HOME/.ssh/id_ed25519}.pub"; [[ -f $me ]] || die "no $me to check against"
    mine=$(ssh-keygen -lf "$me" | awk '{print $2}'); found=false; n=0
    while IFS= read -r line; do
      [[ -z $line || $line == \#* ]] && continue
      grep -qE '^(ssh-ed25519|ecdsa-sha2-nistp(256|384|521)|ssh-rsa|sk-[a-z0-9@.-]+) ' <<<"$line" \
        || die "options or junk before a key type: ${line:0:40}..."
      fp=$(ssh-keygen -lf - <<<"$line" | awk '{print $2}') || die "not a public key: ${line:0:40}..."
      [[ $fp == "$mine" ]] && found=true; n=$((n+1))
    done < "$f"
    $found || die "$f doesn't include your own key ($me): you would lock yourself out"
    confirm "Replace the admin keys on the VM with the $n key(s) in $f?" replace
    vm_ssh 'umask 077; mkdir -p ~/.ssh; cat > ~/.ssh/authorized_keys.new && mv ~/.ssh/authorized_keys.new ~/.ssh/authorized_keys' < "$f"
    vm_ssh true && echo "admin keys replaced; a new connection works" ;;

  check) check_lock ;;
  ssh)   vm_ssh "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
