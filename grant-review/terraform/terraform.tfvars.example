# Copy to terraform.tfvars (gitignored). brine_ips is filled in by `review` from DNS.
# Find values with: openstack flavor list / network list --internal / volume type list

flavor         = "c16-32gb"              # example; about 16 vCPU / 32 GB with a root disk
key_pair       = "admin-key"
# volume_type  = "CEPH-Pool-A"           # optional; unset = the cloud default (on nibi.cloud that fails: set this)
reviewer_cidrs = ["192.0.2.0/24"]        # campus / VPN ranges
admin_cidrs    = ["198.51.100.10/32"]    # admin VPN
dns_cidrs      = ["192.0.2.53/32"]
apt_mirror     = "http://mirror.csclub.uwaterloo.ca/ubuntu/"  # primary + security archive
mirror_cidrs   = ["129.97.134.71/32"]    # REQUIRED: apt_mirror's address(es)
ntp_servers    = ["ntp.sharcnet.ca"]     # ntp.ubuntu.com is unreachable from nibi.cloud
ntp_cidrs      = ["199.241.162.2/32"]    # ntp_servers' addresses
# network      = "def-sharcnet-net"
# volume_size  = 150
