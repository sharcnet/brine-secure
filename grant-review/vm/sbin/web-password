#!/bin/bash
# web-password <username>       (the new password arrives on stdin)
#
# Sets a reviewer's web sign-in password. The password is hashed with SHA-512 crypt and never
# appears in a command line. Production should use SSO instead (see nginx-web.conf).
source /usr/local/lib/brine-review/common.sh

[[ $# -eq 1 ]] || die "usage: web-password <username> < password"
u=$1
need_reviewer "$u"
IFS= read -r pw || [[ -n $pw ]] || die "no password on stdin"
(( ${#pw} >= 12 )) || die "password must be at least 12 characters"
hash=$(printf '%s\n' "$pw" | openssl passwd -6 -stdin)
unset pw
f=$WEB_HT
is_pending "$u" && f=$WEB_HT.pending       # nginx never reads this; activation moves it
tmp=$(mktemp "$f.XXXX")
{ grep -v "^$u:" "$f" 2>/dev/null || true; printf '%s:%s\n' "$u" "$hash"; } > "$tmp"
if [[ $f == "$WEB_HT" ]]; then chown root:www-data "$tmp"; chmod 0640 "$tmp"
else chown root:root "$tmp"; chmod 0600 "$tmp"; fi
mv "$tmp" "$f"
if [[ $f == "$WEB_HT" ]]; then log "web password set for $u"
else log "web password set for $u (works once $u is activated)"; fi
