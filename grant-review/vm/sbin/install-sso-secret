#!/bin/bash
# install-sso-secret            (the CILogon client secret arrives on stdin)
#
# Stores the OIDC client secret for oauth2-proxy, readable by that user only, and restarts it.
# The secret never appears in a command line or the repo.
source /usr/local/lib/brine-review/common.sh
[[ $# -eq 0 ]] || die "usage: install-sso-secret < secret"
getent group oauth2-proxy >/dev/null || die "no oauth2-proxy user: set WEB_AUTH=sso and run review deploy first"
IFS= read -r s || [[ -n $s ]] || die "no secret on stdin"
s="${s//[[:space:]]/}"
(( ${#s} >= 16 )) || die "that doesn't look like a client secret"
d=/etc/brine-review/sso
install -d -m 0750 -o root -g oauth2-proxy "$d"
t=$(mktemp "$d/.cs.XXXX"); printf '%s' "$s" > "$t"; unset s
chown root:oauth2-proxy "$t"; chmod 0640 "$t"; mv "$t" "$d/client-secret"
if [[ ${WEB_AUTH:-basic} == sso ]]; then
  systemctl enable -q oauth2-proxy review-authz
  systemctl restart oauth2-proxy review-authz
  sleep 1
  systemctl is-active --quiet oauth2-proxy || die "oauth2-proxy didn't start: journalctl -u oauth2-proxy"
fi
log "SSO client secret installed"
