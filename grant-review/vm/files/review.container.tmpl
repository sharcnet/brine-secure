# Quadlet template. configure fills in the limits; add-reviewer fills in @USER@ and writes
# /etc/containers/systemd/review-<user>.container.
# [VERIFY] every key against podman-systemd.unit(5) for the installed Podman version.
[Unit]
Description=Grant review container for @USER@
Requires=nginx.service
After=nginx.service
Wants=review-web@@USER@.service

[Container]
Image=localhost/brine-review:current
ContainerName=review-@USER@
HostName=review
Network=none
UserNS=auto
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# Order matters: originals is mounted inside the home mount. No :U here: that would give
# the home to the main process user (fwd). review-own-home gives it to "reviewer" instead.
Volume=/srv/review/homes/@USER@:/home/reviewer
Volume=/srv/review/originals/@USER@:/home/reviewer/originals:ro
Volume=/run/brine-proxy/@USER@:/run/brine:ro
Volume=/etc/brine-review/models.json:/home/reviewer/.pi/agent/models.json:ro
Volume=/run/review-web/@USER@:/run/web
Tmpfs=/tmp:rw,size=256m,nosuid,nodev,noexec
PodmanArgs=--memory=@CTR_MEMORY@ --cpus=@CTR_CPUS@ --pids-limit=@CTR_PIDS@

[Service]
Restart=always
# The runtime (as container root, in whatever UID range UserNS=auto picks) must be able to
# pass through the home to set up mounts inside it, even if the reviewer set it to 0700.
ExecStartPre=/usr/bin/chmod 0711 /srv/review/homes/@USER@
ExecStartPost=/usr/local/sbin/review-own-home @USER@

[Install]
WantedBy=multi-user.target
