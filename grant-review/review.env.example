# Copy to review.env (gitignored). No secrets in here: the LiteLLM credential stays in the
# header file named below.

# The VM. Leave VM_HOST unset to use the Terraform output.
# VM_HOST=203.0.113.20
# On the admin VM (admin-vm/README.md): reach the review VM on the project network.
# VM_ADDRESS=fixed
# REVIEW_SSH_DIR=/etc/grant-review/ssh   # shared pinned host key
VM_ADMIN=ubuntu
# ADMIN_SSH_KEY=~/.ssh/id_ed25519

# brine. BRINE_IPS overrides DNS (e.g. if a VPN resolver answers differently).
BRINE_URL=https://brine.sharcnet.ca
# BRINE_IPS="199.241.160.16"

# LiteLLM key minting. The header file is 0600 and holds one line:
#   Authorization: Bearer <credential limited to the review team, never the master key>
# A credential limited to one team needs LiteLLM's team_admin role, which is an Enterprise
# (paid) feature. Without it, leave LITELLM_ADMIN_HEADER unset: a brine admin mints each key
# and you run `review add <user> <pubkey> <keyfile> <gr-alias>`, and brine's admin revokes keys.
LITELLM_ADMIN_HEADER=$HOME/.config/grant-review/litellm-admin-header
LITELLM_TEAM_ID=
MODELS="North-Mini-Code-1.0 Qwen3.8-27B DeepSeek-V4-Flash-0731"
# SHARED_TEST_KEY=1   # pilot only: every reviewer uses one admin's own brine key (review add
#                     with that keyfile); the tooling then never revokes it
KEY_DURATION=60d        # no later than the retention date
KEY_BUDGET=50
KEY_RPM=30
KEY_TPM=200000

# Web sign-in. basic = a password per reviewer (local tests, first acceptance run);
# sso = CILogon with the Alliance IdP and MFA (reviewers). PRIMER §8.1.
WEB_AUTH=basic
# SSO_HOST=grant-review.example.ca            # DNS name with a trusted certificate (review web-cert)
# SSO_CLIENT_ID=cilogon:oa4mp,2012:/client_id/xxxxxxxx   # from CILogon's registration; secret: review sso-secret
# Defaults, normally left alone:
# SSO_ISSUER=https://cilogon.org
# SSO_IDP=https://idp.alliancecan.ca/idp/shibboleth
# SSO_MFA=https://refeds.org/profile/mfa
# SSO_DOMAIN=alliancecan.ca
# SSO_CIDRS="75.2.49.220/32 99.83.186.75/32"  # cilogon.org; must match sso_cidrs in terraform.tfvars
# CILogon test instance instead: SSO_ISSUER=https://test.cilogon.org
#   SSO_CIDRS="3.33.212.95/32 15.197.204.227/32"  (and the same in sso_cidrs)

# Written to /etc/brine-review/review.conf on the VM by `review deploy`.
ADMIN_CIDRS="198.51.100.10/32"   # space-separated; pam_access and fail2ban ignoreip
QUOTA_GB=2
CTR_MEMORY=2g
CTR_CPUS=2
CTR_PIDS=256

# Optional: a host that pushes the web certificate (e.g. SHARCNET's Ansible). It gets a
# certpush account that can run install-web-cert and nothing else (PRIMER §8.1). Needs
# SSO_HOST, and cert_push_cidrs in terraform.tfvars to match CERT_PUSH_CIDRS.
# CERT_PUSH_KEY='ssh-ed25519 AAAA... ansible@example'
# CERT_PUSH_CIDRS=198.51.100.7/32

# Optional: root login by SSH key for named admins (PRIMER §8). Keys only, only from
# ROOT_SSH_CIDRS (sshd Match, from= on each key, pam_access); root_ssh_cidrs in
# terraform.tfvars to match. One public key per line. Empty: root can't log in.
# ROOT_SSH_KEYS='ssh-ed25519 AAAA... admin1@laptop
# ssh-ed25519 AAAA... admin2@workstation'
# ROOT_SSH_CIDRS="198.51.100.10/32 198.51.100.7/32"
