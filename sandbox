#!/usr/bin/env bash
# Launch a disposable Pi + Brine VM, drop you into it, destroy it when you exit.
# Usage: ./sandbox [--data DIR]    DIR is copied to /data on the VM, read-only.
#        ./sandbox --destroy       clean up if a previous run couldn't.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)

die() { echo "error: $*" >&2; exit 1; }

data="" destroy=false
if [[ ${1:-} == --destroy ]]; then
  destroy=true
elif [[ ${1:-} == --data ]]; then
  [[ -d ${2:-} ]] || die "--data needs a directory"
  data=$(realpath "$2")
  # This folder holds clouds.yaml, brine.key and the SSH key. Never copy it up.
  if [[ $here/ == "${data%/}/"* || ${data%/}/ == "$here/"* ]]; then
    die "--data $data overlaps $here, which holds your credentials"
  fi
fi
cd "$here"

command -v terraform >/dev/null || die "terraform not installed"
[[ -n ${OS_CLOUD:-}${OS_AUTH_URL:-} ]] || die "set OS_CLOUD (clouds.yaml) or source your openrc"
[[ -s brine.key ]] || die "put your Brine API key in ./brine.key"

mkdir -p .ssh && chmod 700 .ssh
[[ -f .ssh/id_ed25519 ]] || ssh-keygen -q -t ed25519 -N "" -C brine-sandbox -f .ssh/id_ed25519
# The VM's host key. We hand it over in user data, so the first SSH connection is already pinned.
[[ -f .ssh/host_ed25519 ]] || ssh-keygen -q -t ed25519 -N "" -C brine-sandbox-host -f .ssh/host_ed25519
export TF_VAR_ssh_host_key=$(cat .ssh/host_ed25519) TF_VAR_ssh_host_public_key=$(cat .ssh/host_ed25519.pub)
echo "sandbox $(cat .ssh/host_ed25519.pub)" > .ssh/known_hosts

brine_ip=$(getent ahostsv4 brine.sharcnet.ca | awk 'NR==1 {print $1}')
[[ -n $brine_ip ]] || die "cannot resolve brine.sharcnet.ca"
cidr=${SSH_FROM_CIDR:-$(curl -fsS https://api.ipify.org)/32}

tf() {
  terraform "$@" -input=false -auto-approve \
    -var "name=brine-$USER" -var "ssh_public_key=$(cat .ssh/id_ed25519.pub)" \
    -var "ssh_from_cidr=$cidr" -var "brine_ip=$brine_ip"
}

terraform init -input=false >/dev/null
if $destroy; then tf destroy; rmdir .sandbox.lock 2>/dev/null || true; exit; fi

# Bootstrap opens egress, so it must only ever run on a brand-new VM. The lock stays
# behind if a session dies or its destroy fails, until ./sandbox --destroy succeeds.
mkdir .sandbox.lock 2>/dev/null || die "a sandbox is running from this folder, or one wasn't cleaned up. If none is running: ./sandbox --destroy"
trap 'rmdir .sandbox.lock' EXIT
if [[ -f terraform.tfstate ]]; then
  left=$(terraform state list)
  [[ -z $left ]] || die "a previous sandbox still exists. Run ./sandbox --destroy first"
fi
trap 'echo "Destroying sandbox..."; tf destroy >/dev/null && rmdir .sandbox.lock || echo "destroy failed: run ./sandbox --destroy" >&2' EXIT

echo "Creating VM (egress open while Pi installs)..."
tf apply -var bootstrap=true >/dev/null
ip=$(terraform output -raw ip)

cat > .ssh/config <<EOF
Host sandbox
  HostName $ip
  IdentityFile $PWD/.ssh/id_ed25519
  IdentitiesOnly yes
  UserKnownHostsFile $PWD/.ssh/known_hosts
  HostKeyAlias sandbox
  StrictHostKeyChecking yes
  ConnectTimeout 5
EOF
s() { ssh -F .ssh/config "$@"; }

echo "Waiting for $ip..."
until s ubuntu@sandbox true 2>/dev/null; do sleep 5; done
s ubuntu@sandbox sudo cloud-init status --wait >/dev/null || die "cloud-init failed: ssh -F .ssh/config ubuntu@sandbox"

echo "Locking egress to Brine only..."
tf apply -var bootstrap=false >/dev/null
# Ask OpenStack, not the VM: the port has only the sandbox group, whose only egress rule is Brine.
port=$(terraform output -raw port_id) group=$(terraform output -raw sandbox_group_id)
[[ $(uv run openstack port show "$port" -f value -c security_group_ids) == "['$group']" ]] \
  || die "sandbox port has extra security groups; refusing to continue"
[[ $(uv run openstack security group rule list "$group" --egress -f value -c "IP Protocol" -c Ethertype -c "IP Range" -c "Port Range") == "tcp IPv4 $brine_ip/32 443:443" ]] \
  || die "sandbox group allows more than Brine; refusing to continue"
tries=0
until s agent@sandbox '! curl -s -m 5 -o /dev/null https://1.1.1.1'; do
  (( ++tries < 6 )) || die "VM can still reach the internet; refusing to continue"
  sleep 5
done

if [[ -n $data ]]; then
  echo "Copying $data to /data (read-only)..."
  rsync -a --chown=root:root --chmod=D555,F444 --rsync-path="sudo rsync" \
    -e "ssh -F '$PWD/.ssh/config'" "$data/" ubuntu@sandbox:/data/
  s ubuntu@sandbox 'sudo mount --bind /data /data && sudo mount -o remount,bind,ro /data'
fi

s agent@sandbox /usr/local/bin/pi-brine-setup.mjs < brine.key

echo "Ready. Run 'pi'. Everything on this VM is destroyed when you exit. It powers off after 8 hours."
s -t agent@sandbox 'cd ~/work && exec bash -l' || true
