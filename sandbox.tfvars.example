# Optional. Copy to sandbox.tfvars (gitignored) only to override the defaults.
#   uv run openstack network list --internal
#   uv run openstack flavor list --sort-column RAM   # needs Disk > 0
#   uv run openstack image list | grep -i ubuntu

# network     = "ctb-brine-tenant-net"  # default: the project's only internal network
# flavor      = "c2-7.5gb-92"           # default p2-4gb (Nibi). Arbutus "p" flavors have no disk: use a "c" one
# image_regex = "^Ubuntu-24\\.04"
